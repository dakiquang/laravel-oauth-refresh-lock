parameters:
    level: max
    # Analyse against the oldest and newest PHP the package supports.
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Laravel 13 types Connection::raw() as literal-string. The increment is built only from
        # identifiers quoted by the query grammar. Laravel 12 does not report it, hence reportUnmatched.
        -
            identifier: argument.type
            message: '#Connection::raw\(\) expects float\|int\|literal-string#'
            path: src/Stores/EloquentTokenStore.php
            reportUnmatched: false
