{
    "name": "dakiquang/laravel-oauth-refresh-lock",
    "description": "Prevent the OAuth2 refresh token race condition in Laravel: one refresh per expiry across queue workers, no invalid_grant from rotating refresh tokens.",
    "keywords": [
        "laravel",
        "oauth2",
        "oauth",
        "refresh-token",
        "token-refresh",
        "race-condition",
        "invalid-grant",
        "cache-lock",
        "atomic-lock",
        "token-rotation",
        "queue",
        "xero",
        "quickbooks",
        "salesforce",
        "league-oauth2-client"
    ],
    "homepage": "https://github.com/dakiquang/laravel-oauth-refresh-lock",
    "license": "MIT",
    "authors": [
        {
            "name": "Quang Dang",
            "homepage": "https://quangdk.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/cache": "^10.48.29 || ^11.44.1 || ^12.0 || ^13.0",
        "illuminate/contracts": "^10.48.29 || ^11.44.1 || ^12.0 || ^13.0",
        "illuminate/database": "^10.48.29 || ^11.44.1 || ^12.0 || ^13.0",
        "illuminate/events": "^10.48.29 || ^11.44.1 || ^12.0 || ^13.0",
        "illuminate/support": "^10.48.29 || ^11.44.1 || ^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "league/oauth2-client": "^2.7",
        "orchestra/testbench": "^8.0 || ^9.2 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "suggest": {
        "league/oauth2-client": "Use LeagueRefresher to refresh tokens for any league/oauth2-client provider."
    },
    "autoload": {
        "psr-4": {
            "Dakiquang\\OAuthRefreshLock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dakiquang\\OAuthRefreshLock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dakiquang\\OAuthRefreshLock\\OAuthRefreshLockServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
