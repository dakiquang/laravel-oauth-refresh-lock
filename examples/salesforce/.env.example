# Consumer Key and Consumer Secret of your External Client App (Setup > External Client App Manager).
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Must match the callback URL of the External Client App.
SALESFORCE_REDIRECT_URI=http://localhost:8000/salesforce/callback
# https://login.salesforce.com, https://test.salesforce.com for sandboxes, or your My Domain URL.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v60.0
